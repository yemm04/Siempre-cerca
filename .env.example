# Siempre Cerca · variables de entorno. Copia este archivo como .env (NUNCA lo subas a GitHub ni lo compartas).
# Después de cambiar algo: detén el servidor (Ctrl + C) y vuelve a ejecutar npm start.
# Para comprobar que tus claves funcionan: npm run check

# ---------- Base de datos (obligatoria) ----------
# Neon → botón "Connect" → cadena de conexión SIN "pooler". Debe terminar en ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Solo si usas un Postgres local sin SSL:
# DATABASE_SSL=false

# Dirección del sitio (se usa en los enlaces de los correos)
APP_URL=http://localhost:4000
# PORT=4000

# ---------- SMS: Twilio Verify (opcional) ----------
# Si se deja vacío, el código sale en la consola del servidor ("[SMS simulado]").
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Tope de SMS por día (protege tu saldo) y de registros por IP cada hora (un salón entero comparte IP)
# SMS_DAILY_LIMIT=300
# SMS_PER_IP_HOUR=40

# ---------- Correo: Brevo (opcional) ----------
# Si se deja vacío, los correos salen en la consola del servidor ("[correo simulado]").
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Siempre Cerca

# ---------- Inteligencia artificial (opcional) ----------
# Si AI_API_KEY está vacía, todo funciona con reglas. Con clave, la IA da una segunda opinión al revisar
# anuncios dudosos y redacta consejos, resúmenes y las respuestas del asistente de ayuda.
# AI_PROVIDER: gemini (Google) o anthropic (Claude)
AI_PROVIDER=gemini
AI_API_KEY=
# AI_MODEL=            (vacío = modelo por defecto del proveedor; confírmalo en la documentación del proveedor)
AI_DAILY_LIMIT=200
# Alertas sin actividad se archivan solas después de estos días (se avisa 2 días antes)
# ARCHIVE_DAYS=14
